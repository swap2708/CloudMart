# CloudMart Backend Environment Configuration
APP_NAME=CloudMart API
APP_VERSION=1.0.0
DEBUG=False

# Database Configuration (PostgreSQL for production/development)
DATABASE_URL=postgresql://cloudmart:cloudmart_password@localhost:5432/cloudmart_db

# Security & JWT Configuration
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@cloudmart.com
ADMIN_PASSWORD=AdminPassword123!

# AWS Configuration (for Lambda / CloudWatch / SQS integration)
AWS_REGION=us-east-1
