# ==============================================================================
# CloudMart - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# PostgreSQL
POSTGRES_USER=cloudmart
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=cloudmart
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin seed user
ADMIN_EMAIL=admin@cloudmart.dev
ADMIN_PASSWORD=changeme_admin_dev_only

# Frontend
VITE_API_URL=http://localhost:8000

# AWS (optional, not required for local dev)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Environment
ENVIRONMENT=development
